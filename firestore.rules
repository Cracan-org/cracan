// Assumed data model: profiles/{uid}, private to the signed-in account.
// Required fields: displayName (string <=100), focus (string <=240),
// bookmarks (list <=20 containing only mission, updates, resources, community),
// updatedAt (timestamp set with serverTimestamp()). No case or intake data.
// Ownership is the immutable document path. Admin is a server-set custom claim.
// volunteers/{uid}: one sign-up per account, readable only by its owner and
// admins. email must equal the signed-in account's verified email. Skill ids
// must match src/content.js. No case or intake data.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function canWrite(uid) {
      return isOwner(uid) && request.auth.token.email_verified == true;
    }

    function isValidProfile(data) {
      let fields = ['displayName', 'focus', 'bookmarks', 'updatedAt'];
      return data.keys().hasAll(fields)
        && data.keys().hasOnly(fields)
        && data.displayName is string && data.displayName.size() <= 100
        && data.focus is string && data.focus.size() <= 240
        && data.bookmarks is list && data.bookmarks.size() <= 20
        && data.bookmarks.hasOnly(['mission', 'updates', 'resources', 'community'])
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    // Admins (custom claim admin == true, set server-side only) can review
    // and remove member profiles but never edit someone else's content.
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    match /profiles/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if canWrite(uid) && isValidProfile(request.resource.data);
      allow update: if canWrite(uid) && isValidProfile(request.resource.data);
      allow delete: if canWrite(uid) || isAdmin();
    }

    function isValidVolunteer(data) {
      let fields = ['name', 'email', 'location', 'skills', 'availability', 'languages', 'note', 'updatedAt'];
      return data.keys().hasAll(fields)
        && data.keys().hasOnly(fields)
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email == request.auth.token.email
        && data.location is string && data.location.size() > 0 && data.location.size() <= 120
        && data.skills is list && data.skills.size() > 0 && data.skills.size() <= 12
        && data.skills.hasOnly(['organizing', 'court-watch', 'legal', 'records', 'translation', 'support',
                                'outreach', 'research', 'writing', 'tech', 'design', 'fundraising'])
        && data.availability in ['events', 'monthly', 'weekly']
        && data.languages is string && data.languages.size() <= 120
        && data.note is string && data.note.size() <= 500
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    match /volunteers/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if canWrite(uid) && isValidVolunteer(request.resource.data);
      allow delete: if canWrite(uid) || isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
